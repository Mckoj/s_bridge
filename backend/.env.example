# S-Bridge Backend Environment Variables Example
# Copy this file to .env and set your secrets

# Server Configuration
PORT=5000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Database (Neon PostgreSQL connection string)
DATABASE_URL="postgresql://user:password@ep-sample-123456.aws.neon.tech/neondb?sslmode=require"

# Authentication
JWT_SECRET=your_super_secret_jwt_key_change_in_production

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email Dispatch (Mailgun / SMTP)
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@mg.yourdomain.com
SMTP_PASS=your_mailgun_smtp_password
SMTP_FROM="S-Bridge <noreply@yourdomain.com>"
FRONTEND_URL=http://localhost:5173
